# Optional Twelve Data API key for real-time Forex, Stocks, ETFs, Futures, and Indices
# On Cloudflare Workers, set via: wrangler secret put TWELVEDATA_KEY
TWELVEDATA_KEY=
# Where crypto comes from: binance (default, public !miniTicker@arr) | twelvedata (BTC/USD, ETH/USD; needs the Venture plan for volume)
CRYPTO_PROVIDER=binance
# Shared secret for the internal /td/* proxy on vektor-market (guards paid Twelve Data REST credits).
# Set the SAME value on both: `cd workers/market && wrangler secret put INTERNAL_TD_SECRET` and
# `wrangler pages secret put INTERNAL_TD_SECRET --project-name screener`. Without it, chart history falls back to Yahoo.
INTERNAL_TD_SECRET=
