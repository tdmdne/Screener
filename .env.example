# Optional Twelve Data API key for real-time Forex, Stocks, ETFs, Futures, and Indices
# On Cloudflare Workers, set via: wrangler secret put TWELVEDATA_KEY
TWELVEDATA_KEY=
# Where crypto comes from: binance (default, public !miniTicker@arr) | twelvedata (BTC/USD, ETH/USD; needs the Venture plan for volume)
CRYPTO_PROVIDER=binance
